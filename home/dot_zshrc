zinit ice wait lucid
zinit light zdharma-continuum/history-search-multi-word

zinit ice wait lucid atload"_zsh_autosuggest_start"
zinit light zsh-users/zsh-autosuggestions

zinit ice wait lucid atinit"ZINIT[COMPINIT_OPTS]=-C; zicompinit; zicdreplay"
zinit light zdharma-continuum/fast-syntax-highlighting

# Keep command-line path highlighting consistent with the Starship directory color.
FAST_HIGHLIGHT_STYLES[path]="fg=#3a96dd"
FAST_HIGHLIGHT_STYLES[path-to-dir]="fg=#3a96dd"

### custom commands

alias ls='ls --color=auto'
alias ll='ls -lah --color=auto'
alias la='ls -a --color=auto'

# AI related
alias ccusage='pnpm dlx ccusage'
alias codexusage='pnpm dlx @ccusage/codex@latest'

alias cc='claude'
alias cc-deepseek='claude --settings ~/.agents/claude/cc-deepseek.settings.json'
alias deepseek='claude --settings ~/.agents/claude/cc-deepseek.settings.json'

alias ccconfig='code ~/.claude'
alias codexconfig='code ~/.codex'
alias aiconfig='code ~/.agents'

# List the directory contents
function cd {
        builtin cd "$@" || return
        local count=$(ls | wc -l)
        if (( count <= 50 )); then
                ls -F --color=auto
        else
                echo "There are $count entries in $(pwd)"
        fi
}

