{
  "env": {},
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(chezmoi *)",
      "PowerShell(chezmoi *)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/fxtwitter-webfetch.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 -I ~/.claude/statusline-command.py"
  },
  "enabledPlugins": {},
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true
}
