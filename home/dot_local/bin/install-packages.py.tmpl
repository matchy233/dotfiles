#!/usr/bin/env python3
"""Install this machine's Windows packages from chezmoi's packages.yaml.

    python ~/.local/bin/install-packages.py            # base + dev tiers (chezmoi apply runs this)
    python ~/.local/bin/install-packages.py --desktop  # GUI apps; run it when you are ready to log in
    add --dry-run to only list what would be installed

Already-installed packages are skipped, so re-running is safe.
Generated by chezmoi from .chezmoidata/packages.yaml; edit that file, not this one.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import winreg
from pathlib import Path

DATA = json.loads({{ dict "role" (dig "role" "server" .) "packages" .packages | toJson | quote }})
TIERS_BY_ROLE = {"server": ["base"], "dev": ["base", "dev"], "desktop": ["base", "dev"]}
WINGET_FLAGS = [
    "--exact", "--silent", "--disable-interactivity",
    "--accept-package-agreements", "--accept-source-agreements",
]


def run(command: list[str], dry_run: bool) -> bool:
    print("+", " ".join(command), flush=True)
    if dry_run:
        return True
    return subprocess.run(command).returncode == 0


def scoop_installed(scoop: str) -> set[str]:
    exported = subprocess.run([scoop, "export"], capture_output=True, text=True, check=True)
    return {app["Name"].lower() for app in json.loads(exported.stdout).get("apps", [])}


def install_scoop(entries: list[dict], dry_run: bool) -> list[str]:
    wanted = [e for e in entries if e.get("scoop")]
    if not wanted:
        return []
    scoop = shutil.which("scoop")
    if not scoop:
        print("scoop is missing. Install it (no admin needed), then re-run:\n"
              "  irm get.scoop.sh | iex")
        return [e["name"] for e in wanted]
    have = scoop_installed(scoop)
    missing = [e["scoop"] for e in wanted if e["scoop"].split("/")[-1].lower() not in have]
    if not missing:
        return []
    buckets = subprocess.run([scoop, "bucket", "list"], capture_output=True, text=True).stdout
    for bucket in sorted({m.split("/")[0] for m in missing if "/" in m}):
        if bucket not in buckets:
            run([scoop, "bucket", "add", bucket], dry_run)
    return [] if run([scoop, "install", *missing], dry_run) else missing


def winget_has(entry: dict) -> bool:
    command = ["winget", "list", "--id", entry["winget"], "--exact", "--accept-source-agreements"]
    return subprocess.run(command, capture_output=True).returncode == 0


def install_winget(entries: list[dict], dry_run: bool) -> tuple[list[str], list[str]]:
    installed, failed = [], []
    for entry in (e for e in entries if e.get("winget")):
        if winget_has(entry):
            continue
        command = ["winget", "install", "--id", entry["winget"], *WINGET_FLAGS]
        if entry.get("winget_source"):
            command += ["--source", entry["winget_source"]]
        if entry.get("winget_override"):
            command += ["--override", entry["winget_override"]]
        (installed if run(command, dry_run) else failed).append(entry["name"])
    return installed, failed


def startup_entries() -> list[str]:
    names = []
    for hive in (winreg.HKEY_CURRENT_USER, winreg.HKEY_LOCAL_MACHINE):
        try:
            key = winreg.OpenKey(hive, r"Software\Microsoft\Windows\CurrentVersion\Run")
        except OSError:
            continue
        with key:
            index = 0
            while True:
                try:
                    names.append(winreg.EnumValue(key, index)[0])
                except OSError:
                    break
                index += 1
    startup = Path(os.environ["APPDATA"]) / "Microsoft/Windows/Start Menu/Programs/Startup"
    names += [p.stem for p in startup.glob("*.lnk")]
    return sorted(set(names), key=str.lower)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--desktop", action="store_true", help="install the GUI apps instead")
    parser.add_argument("--dry-run", action="store_true", help="only print what would be installed")
    args = parser.parse_args()

    role = DATA["role"]
    if args.desktop and role != "desktop":
        print(f"This machine's role is {role!r}; the desktop tier is for role 'desktop'.")
        return 1
    tiers = ["desktop"] if args.desktop else TIERS_BY_ROLE[role]
    entries = [e for tier in tiers for e in DATA["packages"][tier]]
    print(f"role={role} tiers={','.join(tiers)}{' (dry run)' if args.dry_run else ''}")

    failed = install_scoop(entries, args.dry_run)
    installed, winget_failed = install_winget(entries, args.dry_run)
    failed += winget_failed

    if args.desktop:
        login = [e["name"] for e in entries if e.get("login") and e["name"] in installed]
        if login:
            print("\nNewly installed apps that still need you to log in:\n  " + "\n  ".join(login))
        print("\nApps that start with Windows (turn off the ones you don't need in "
              "Settings > Apps > Startup):\n  " + "\n  ".join(startup_entries()))
    if failed:
        print("\nFailed: " + ", ".join(failed), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
