{{- if eq .chezmoi.os "linux" }}
{{- if contains "microsoft" (.chezmoi.kernel.osrelease | lower) }}

# Shared WSL-specific settings
export WIN_FONT_DIR="/mnt/c/Windows/Fonts"

# Scoop under whichever Windows profile has it. Found by glob, so it needs neither a fixed
# user name nor WSL interop (cmd.exe is missing in an ssh session).
_win_scoop=(/mnt/c/Users/*/scoop/shims(N/:h))
_win_scoop=${_win_scoop[1]}
if [[ -n $_win_scoop && ":$PATH:" != *":$_win_scoop/shims:"* ]]; then
    export PATH="$PATH:$_win_scoop/shims"
fi

if command -v op.exe >/dev/null 2>&1; then
    alias op='op.exe'
elif [[ -n $_win_scoop && -x "$_win_scoop/apps/1password-cli/current/op.exe" ]]; then
    alias op="$_win_scoop/apps/1password-cli/current/op.exe"
fi
unset _win_scoop

{{- end }}
{{- end }}
