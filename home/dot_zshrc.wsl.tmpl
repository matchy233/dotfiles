{{- if eq .chezmoi.os "linux" }}
{{- if contains "microsoft" (.chezmoi.kernel.osrelease | lower) }}

# Shared WSL-specific settings
export WIN_FONT_DIR="/mnt/c/Windows/Fonts"

if [[ -d /mnt/c/Users/<windows-user>/scoop/shims && ":$PATH:" != *:/mnt/c/Users/<windows-user>/scoop/shims:* ]]; then
    export PATH="$PATH:/mnt/c/Users/<windows-user>/scoop/shims"
fi

if command -v op.exe >/dev/null 2>&1; then
    alias op='op.exe'
elif [[ -x /mnt/c/Users/<windows-user>/scoop/apps/1password-cli/current/op.exe ]]; then
    alias op='/mnt/c/Users/<windows-user>/scoop/apps/1password-cli/current/op.exe'
fi

{{- end }}
{{- end }}
