#!/usr/bin/env python3
# Point each ub-mode companion tool's checkout at the repo and branch in .chezmoidata/ub-tools.yaml,
# then build its virtualenv with uv, installing uv first if needed.
# Works on Linux, macOS and Windows; re-running is a no-op once every tool is in place and imports.
# externals-sha256: {{ include ".chezmoiexternal.toml.tmpl" | sha256sum }}

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path({{ .chezmoi.homeDir | quote }})
TOOLS = HOME / ".agents/tools/unclebob"
PYTHON = "3.12"  # uv downloads a managed CPython when no suitable one is installed
WINDOWS = sys.platform == "win32"
UV_INSTALL_DIR = HOME / ".local/bin"  # passed to the installer, so the location is known
# Where uv may already live when it is not on PATH (current and older installer defaults).
UV_DIRS = [UV_INSTALL_DIR, HOME / ".cargo/bin"]
UV_NAME = "uv.exe" if WINDOWS else "uv"
SOURCES = json.loads({{ .ubTools | toJson | quote }})


def git(tool: Path, *args: str, check: bool = False) -> str:
    result = subprocess.run(["git", "-C", str(tool), *args], capture_output=True, text=True)
    if check and result.returncode != 0:
        raise SystemExit(f"{tool.name}: git {' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout.strip() if result.returncode == 0 else ""


def default_branch(tool: Path) -> str:
    git(tool, "remote", "set-head", "origin", "--auto")
    return git(tool, "symbolic-ref", "--short", "refs/remotes/origin/HEAD").removeprefix("origin/")


def has_local_work(tool: Path) -> bool:
    if git(tool, "status", "--porcelain"):
        return True
    return git(tool, "rev-list", "--count", "@{upstream}..HEAD") not in ("", "0")


def point_at_source(tool: Path, source: dict) -> None:
    """chezmoi reads an external's url and clone.args only on the first clone."""

    url = f"https://github.com/{source['repo']}.git"
    branch = source.get("branch")
    on_url = git(tool, "remote", "get-url", "origin") == url
    on_branch = branch is None or git(tool, "rev-parse", "--abbrev-ref", "HEAD") == branch
    if on_url and on_branch:
        return
    if has_local_work(tool):
        print(f"{tool.name}: local changes or commits; not moving it to {url}")
        return
    git(tool, "remote", "set-url", "origin", url, check=True)
    git(tool, "fetch", "-q", "origin", check=True)
    target = branch or default_branch(tool)
    if not target:
        raise SystemExit(f"{tool.name}: cannot tell the default branch of {url}")
    git(tool, "checkout", "-q", "-B", target, f"origin/{target}", check=True)
    print(f"{tool.name}: following {url} ({target})")


def locate_uv():
    found = shutil.which("uv")
    if found:
        return found
    for directory in UV_DIRS:
        candidate = directory / UV_NAME
        if candidate.is_file():
            return str(candidate)
    return None


def install_uv() -> None:
    env = dict(os.environ, UV_INSTALL_DIR=str(UV_INSTALL_DIR), UV_NO_MODIFY_PATH="1")
    if WINDOWS:
        command = [
            "powershell", "-NoProfile", "-ExecutionPolicy", "ByPass", "-Command",
            "irm https://astral.sh/uv/install.ps1 | iex",
        ]
        subprocess.run(command, check=True, env=env)
        return
    fetch = "curl -LsSf" if shutil.which("curl") else "wget -qO-"
    if fetch.startswith("wget") and not shutil.which("wget"):
        raise SystemExit("neither curl nor wget is available to download the uv installer")
    subprocess.run(f"{fetch} https://astral.sh/uv/install.sh | sh", shell=True, check=True, env=env)


def find_uv() -> str:
    found = locate_uv()
    if found:
        return found
    print(f"uv not found; installing it into {UV_INSTALL_DIR}")
    install_uv()
    found = locate_uv()
    if not found:
        raise SystemExit("uv installation did not produce an executable in a known location")
    return found


def venv_python(tool: Path) -> Path:
    return tool / ".venv" / ("Scripts/python.exe" if WINDOWS else "bin/python")


def venv_works(tool: Path) -> bool:
    python = venv_python(tool)
    if not python.exists():
        return False
    check = subprocess.run([str(python), "-c", f"import {tool.name}"], capture_output=True)
    return check.returncode == 0


def build(tool: Path, uv: str) -> None:
    venv = tool / ".venv"
    shutil.rmtree(venv, ignore_errors=True)
    subprocess.run([uv, "venv", "-q", "--python", PYTHON, str(venv)], cwd=tool, check=True)
    subprocess.run(
        [uv, "pip", "install", "-q", "--python", str(venv_python(tool)), "-e", "."],
        cwd=tool,
        check=True,
    )
    if not venv_works(tool):
        raise SystemExit(f"{tool.name}: virtualenv built but `import {tool.name}` fails")


def main() -> None:
    tools = sorted(p for p in TOOLS.glob("*") if (p / "pyproject.toml").is_file())
    if not tools:
        print(f"no tools under {TOOLS}; nothing to build")
        return
    uv = None
    for tool in tools:
        if tool.name in SOURCES and (tool / ".git").exists():
            point_at_source(tool, SOURCES[tool.name])
        if venv_works(tool):
            print(f"{tool.name}: ok")
            continue
        uv = uv or find_uv()
        build(tool, uv)
        print(f"{tool.name}: built")


if __name__ == "__main__":
    os.environ.setdefault("UV_NO_PROGRESS", "1")
    sys.exit(main())
