{{- $host := .chezmoi.hostname | lower -}}
{{- $os := .chezmoi.os -}}
{{- $member := false -}}
{{- range .paseoHosts -}}
{{- if and (get . "tailnet") (eq (get . "machine" | lower) $host) (eq (get . "os") $os) -}}{{- $member = true -}}{{- end -}}
{{- end -}}
{{- $want := list -}}
{{- range .paseoHosts -}}
{{- $self := and (get . "tailnet") (eq (get . "machine" | lower) $host) (eq (get . "os") $os) -}}
{{- if and (not $self) (or (not (get . "tailnet")) $member) -}}
{{- $want = append $want (dict "label" .label "connection" .connection) -}}
{{- end -}}
{{- end -}}
#!/usr/bin/env python3

import json
import shutil
import subprocess

WANTED = json.loads({{ $want | toJson | quote }})


def run_paseo(exe, *args):
    return subprocess.run([exe, *args], capture_output=True, text=True, timeout=120)


def main():
    exe = shutil.which("paseo")
    if exe is None:
        print("paseo-hosts: paseo CLI not found, skipping")
        return

    listing = run_paseo(exe, "host", "ls", "--json")
    if listing.returncode != 0:
        print("paseo-hosts: daemon not reachable, skipping:", listing.stderr.strip())
        return
    known = {host["label"] for host in json.loads(listing.stdout)}

    for host in WANTED:
        if host["label"] in known:
            continue
        added = run_paseo(exe, "host", "add", host["connection"], "--label", host["label"])
        if added.returncode == 0:
            print("paseo-hosts: added", host["label"])
        else:
            print("paseo-hosts: failed to add", host["label"], "-", added.stderr.strip())


main()
