#!/usr/bin/env python3
# Install this machine's CLI and dev packages from .chezmoidata/packages.yaml.
# Windows: scoop + winget via ~/.local/bin/install-packages.py (GUI apps are left for --desktop).
# Linux: home-manager switch. Installing Nix itself needs sudo, so it is left to you.
# Re-runs when the package list or the machine role changes.
# packages-sha256: {{ .packages | toJson | sha256sum }}
# role: {{ dig "role" "server" . }}

import os
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path({{ .chezmoi.homeDir | quote }})
ROLE = {{ dig "role" "server" . | quote }}

{{ if eq .chezmoi.os "windows" -}}
sys.exit(subprocess.run([sys.executable, str(HOME / ".local/bin/install-packages.py")]).returncode)
{{- else if eq .chezmoi.os "linux" -}}
FLAKE = f"{HOME / '.config/home-manager'}#default"
NIX_BIN = Path("/nix/var/nix/profiles/default/bin")

# A shell opened before Nix was installed lacks NIX_BIN, and home-manager runs `nix` by name.
if NIX_BIN.is_dir():
    os.environ["PATH"] = f"{NIX_BIN}:{os.environ.get('PATH', '')}"


def home_manager() -> list[str] | None:
    if found := shutil.which("home-manager"):
        return [found]
    nix = shutil.which("nix")
    if not nix:
        return None
    return [nix, "--extra-experimental-features", "nix-command flakes",
            "run", "home-manager/master", "--"]


command = home_manager()
if command is None:
    print("Nix is not installed, so the package list was skipped. Install it (asks for sudo),\n"
          "open a new shell, then run `chezmoi apply` again:\n"
          "  curl -fsSL https://install.determinate.systems/nix | sh -s -- install")
    sys.exit(0)
subprocess.run([*command, "switch", "--flake", FLAKE], check=True)

if ROLE in ("dev", "desktop") and not shutil.which("cc"):
    print("No C/C++ compiler found. Rust and C++ builds need one:\n"
          "  sudo apt install build-essential")
{{- end }}
